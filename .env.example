# Copy to .env and fill in. No accounts, no login screen - the browser never sees these keys.
SMALLEST_API_KEY=your_smallest_ai_api_key
GROQ_API_KEY=your_groq_api_key

# Server
PORT=12000

# Groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=120
GROQ_TEMPERATURE=0.3
HISTORY_TURNS=6

# smallest.ai speech-to-text
SMALLEST_STT_MODEL=pulse
STT_LANGUAGE=en
STT_SAMPLE_RATE=16000
STT_EOU_TIMEOUT_MS=400
STT_ITN=true
STT_VAD_EVENTS=true

# smallest.ai text-to-speech. `language` must be explicit: the `auto` default is
# region-gated and fails on some accounts. Voice catalogs differ between
# lightning_v3.1 and lightning_v3.1_pro, so pair voice_id with the matching model.
SMALLEST_TTS_MODEL=lightning_v3.1_pro
SMALLEST_TTS_VOICE=meher
SMALLEST_TTS_LANGUAGE=en
SMALLEST_TTS_SAMPLE_RATE=24000
SMALLEST_TTS_BACKOFF_MS=0
SMALLEST_TTS_MAX_BUFFER_DELAY_MS=250

# Optional: override the built-in spoken-voice system prompt
SYSTEM_PROMPT=
