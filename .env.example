# Copy to .env and fill in. No accounts, no login screen - the browser never sees these keys.
SMALLEST_API_KEY=your_smallest_ai_api_key
GROQ_API_KEY=your_groq_api_key

# Optional tuning
PORT=12000
GROQ_MODEL=llama-3.1-8b-instant
SMALLEST_STT_MODEL=pulse
SMALLEST_TTS_MODEL=lightning_v3.1
SMALLEST_TTS_VOICE=magnus
SMALLEST_TTS_SAMPLE_RATE=24000
STT_SAMPLE_RATE=16000
STT_LANGUAGE=en
STT_EOU_TIMEOUT_MS=600
SYSTEM_PROMPT=
